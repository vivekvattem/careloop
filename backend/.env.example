# Copy this file to .env for local development. Never commit the real .env.
CARELOOP_APP_NAME=CareLoop API
CARELOOP_ENVIRONMENT=development
CARELOOP_API_PREFIX=/api/v1
CARELOOP_DATABASE_URL=postgresql+psycopg://careloop:careloop@localhost:5432/careloop
CARELOOP_JWT_SECRET=replace-with-at-least-32-random-characters
CARELOOP_JWT_ALGORITHM=HS256
CARELOOP_ACCESS_TOKEN_MINUTES=15
CARELOOP_REFRESH_TOKEN_DAYS=7
CARELOOP_PASSWORD_RESET_MINUTES=20
CARELOOP_PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60
CARELOOP_SLOT_HOLD_MINUTES=5
CARELOOP_LLM_PROVIDER=openai_compatible
CARELOOP_LLM_API_KEY=your_groq_api_key_here
CARELOOP_LLM_BASE_URL=https://api.groq.com/openai/v1
CARELOOP_LLM_MODEL=openai/gpt-oss-20b
CARELOOP_LLM_TIMEOUT_SECONDS=8
# Enable only when an LLM API key is intentionally configured.
CARELOOP_LLM_ENABLED=false
CARELOOP_FRONTEND_ORIGIN=http://localhost:5173
# Comma-separated explicit browser origins. Do not use * with credentials.
CARELOOP_CORS_ORIGINS=http://localhost:5173
# Public API base URL is required for production OAuth/cross-site cookies.
CARELOOP_PUBLIC_API_URL=
CARELOOP_COOKIE_SAMESITE=lax
CARELOOP_EMAIL_PROVIDER=log
CARELOOP_EMAIL_FROM_ADDRESS=notifications@careloop.app
CARELOOP_SENDGRID_API_KEY=
CARELOOP_RESEND_API_KEY=
CARELOOP_RESEND_BASE_URL=https://api.resend.com
CARELOOP_EMAIL_TIMEOUT_SECONDS=8
CARELOOP_SMTP_HOST=localhost
CARELOOP_SMTP_PORT=1025
CARELOOP_SMTP_USERNAME=
CARELOOP_SMTP_PASSWORD=
CARELOOP_SMTP_USE_STARTTLS=false
CARELOOP_NOTIFICATION_MAX_ATTEMPTS=5
CARELOOP_NOTIFICATION_BASE_RETRY_SECONDS=60
CARELOOP_NOTIFICATION_POLL_SECONDS=5
CARELOOP_NOTIFICATION_STALE_CLAIM_SECONDS=300
# Set true in production only when a non-log provider and credentials are configured.
CARELOOP_EMAIL_DELIVERY_REQUIRED=false
CARELOOP_GOOGLE_CALENDAR_ENABLED=false
CARELOOP_GOOGLE_CLIENT_ID=
CARELOOP_GOOGLE_CLIENT_SECRET=
CARELOOP_GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google-calendar/callback
CARELOOP_GOOGLE_TOKEN_ENCRYPTION_KEY=
CARELOOP_GOOGLE_CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar.events
# Phase 4 post-visit generation reuses the same provider settings; keep the key placeholder-only.

# Used only by: python -m app.cli.create_admin
CARELOOP_ADMIN_EMAIL=admin@example.com
CARELOOP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
CARELOOP_ADMIN_FULL_NAME=Development Admin
